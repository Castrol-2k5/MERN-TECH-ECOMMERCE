# ==============================================================================
# 🚀 BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Đề tài: MERN Stack Omnichannel Retail Platform
# Lưu ý: Copy file này thành file .env và điền các giá trị thực tế ở môi trường Local/Staging.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # Options: development, production, test
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173 # URL đại diện cho React Vite Storefront/POS

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Chuỗi kết nối MongoDB Local hoặc MongoDB Atlas Cluster
MONGODB_URI=mongodb://localhost:27017/mern_omnichannel_db
# Hoặc MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern_omnichannel_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & BCRYPT)
# ------------------------------------------------------------------------------
# Mã bí mật ký JWT Token (Bắt buộc phải phức tạp ở môi trường Production)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=8h # Hạn hiệu lực của Token (8h phù hợp ca làm việc POS)
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY INTEGRATION (SANDBOX MODE)
# ------------------------------------------------------------------------------
# Cổng thanh toán VNPAY (Sandbox)
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/v1/orders/vnpay-return

# Cổng thanh toán Stripe (Sandbox)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. MAIL SERVER CONFIGURATION (SENDGRID / NODEMAILER)
# ------------------------------------------------------------------------------
# Cấu hình gửi mail thông báo đơn hàng / khôi phục mật khẩu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
MAIL_FROM_ADDRESS=noreply@techstore.com
MAIL_FROM_NAME="TechStore Vietnam"

# ------------------------------------------------------------------------------
# 6. LOGGING & DEBUGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=debug # Options: error, warn, info, http, debug